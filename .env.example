# Copy to .env (deploy.sh generates it for you). Never commit the real .env.
# ── Telegram API (from https://my.telegram.org) ──
# Required: Telegrarr does not start until these are set here. A real value set here
# wins over a saved one, and the app can't change it until you remove it here.
TG_API_ID=0
TG_API_HASH=

# ── Identity for file ownership ──
# The app runs as this user and group: use your host user (`id -u`, `id -g`). The
# container re-owns /data on every start, and /downloads when its owner differs.
# Must be numbers above 0: root is refused and the container won't start.
PUID=1000
PGID=1000

# ── Host media root (bind-mounted to /media inside the container) ──
# Only standalone mode writes here; *arr mode can leave it unset (default ./media).
# TELEARR_MEDIA_ROOT=/media/youruser/MediaDrive1

# ── Host downloads dir (bind-mounted to /downloads here AND in Sonarr/Radarr) ──
# *arr grabs land in /downloads/telegram/<tv|movies>/<release name>/<file>.
# PATH_TO_DOWNLOADS=/mnt/downloads
# Downloads base inside the container (also editable in Settings).
TELEARR_DOWNLOADS_DIR=/downloads

# Host address the web UI binds to. 127.0.0.1 keeps it local-only.
TELEARR_BIND_ADDR=0.0.0.0

# ── Library paths (as seen INSIDE the container; /media = TELEARR_MEDIA_ROOT) ──
TELEARR_TV_DIR=/media/TvShows/1080p
TELEARR_TV_DIR_4K=/media/TvShows/4K
TELEARR_MOVIES_DIR=/media/Movies/1080p
TELEARR_MOVIES_DIR_4K=/media/Movies/4K
TELEARR_OTHER_DIR=/media/Other
TELEARR_MIN_FREE_GB=50

# ── Download performance (install cryptg first — it's in requirements) ──
# Account safety: more senders/concurrency risks Telegram FloodWait on a personal account.
TELEARR_DL_WORKERS=4
TELEARR_MAX_CONCURRENT=2
TELEARR_DL_CHUNK_MB=1
TELEARR_PROGRESS_INTERVAL=1.0

# ── Web / auth ──
# deploy.sh fills the secret key and admin password with random values.
TELEARR_SECRET_KEY=change-me
TELEARR_ADMIN_USER=admin
TELEARR_ADMIN_PASS=change-me

# ── Optional integrations ──
# Leave PLEX_* empty to manage them in the UI. A value set here wins over the saved
# one, and the UI and API can't change that setting until you remove it here.
PLEX_URL=
PLEX_TOKEN=
TELEARR_NOTIFY_WEBHOOK=

# ── TMDB and *arr connections (optional) ──
# Leave empty to manage these in the UI. A value set here wins over the saved one,
# and the UI and API can't change that setting until you remove it here.
TELEARR_TMDB_KEY=
TELEARR_PROWLARR_URL=
TELEARR_PROWLARR_KEY=
TELEARR_SONARR_URL=
TELEARR_SONARR_KEY=
TELEARR_RADARR_URL=
TELEARR_RADARR_KEY=

# ── Proxy / VPN for Telegram (optional) ──
# Route MTProto through a proxy when your ISP throttles/blocks Telegram data
# centers (fixes downloads that stall on a specific DC). Leave empty to set it from
# the UI (Settings → Integrations → Proxy / VPN). A value here wins over the saved
# one, and the UI and API can't change it until you remove it here.
#   socks5://[user:pass@]host:port   socks4://host:port
#   http://[user:pass@]host:port     mtproxy://<secret>@host:port
TELEARR_PROXY=
